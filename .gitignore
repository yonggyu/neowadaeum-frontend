# ── 의존성 · 빌드 산출물 ─────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
coverage/

# ── 시크릿 (§7.1 — 실제 값은 .env 에만, 커밋하지 않는다) ─────
.env
.env.*
!.env.example

# ── 생성물 ───────────────────────────────────────────────────
# 계약에서 만들어지는 타입. 소스가 아니라 산출물이며, 계약이 진실의 원천이다.
src/api/schema.d.ts

# CI 가 계약을 받아 두는 자리 (.github/workflows/ci.yml). 로컬에서는 형제 경로를 쓴다.
_contract/

# tsc -b 의 증분 빌드 캐시. 머신마다 다르고 커밋할 이유가 없다.
*.tsbuildinfo

# 에이전트 worktree 가 여기 생긴다. 레포의 복사본이라 커밋 대상이 아니고,
# 안의 dist/ 가 린트에 걸려 실제로 오류 3037개짜리 헛경보를 냈다.
.claude/

# ── 에디터 · OS ──────────────────────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
